# Quiz 10 cheat sheet (Problem Set 11)
# Round every numeric answer to the hundredths place.
# Where the question could be flipped (positive vs negative, true vs false, etc.), the opposite version is listed too.

# ------------------------------------------------------------------
# A regression gives log(y)-hat = 1.5 + 0.053 x1 - 0.014 x2. If x1 rises by 3 and x2 rises by 4, by about what percent does predicted y change? (Give a percent; it can be negative.) (round to the hundredths)
# Hint: log-level MLR: %change y = 100 * (beta1 * change in x1 + beta2 * change in x2). Here beta2 is negative.
b1  <- 0.053        # edit
b2  <- -0.014       # edit
dx1 <- 3            # edit (use a negative number if x falls)
dx2 <- 4            # edit (use a negative number if x falls)
round(100 * (b1 * dx1 + b2 * dx2), 2)   # 10.30
# Opposite versions (just change the inputs above):
#   both fall (dx1 = -3, dx2 = -4)   -> -10.30
#   x1 rises 3, x2 falls 4           -> 21.50
#   x1 falls 3, x2 rises 4           -> -21.50

# ------------------------------------------------------------------
# Data: wage1 (wage = average hourly earnings in dollars; educ = years of education; exper = years of experience; tenure = years with the current employer). Run reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1). By about what percent does predicted wage change when experience rises by 2 years and tenure rises by 1 year, holding education fixed? (Give a percent. Use the unrounded coefficients.) (round to the hundredths)
# Hint: %change wage = 100 * (beta_exper * 2 + beta_tenure * 1). With b <- reg$coefficients: 100 * (b[3]*2 + b[4]*1).
library(wooldridge)
data("wage1")
reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1)
b <- reg$coefficients
d_exper  <- 2       # edit (negative if it falls)
d_tenure <- 1       # edit (negative if it falls)
round(unname(100 * (b[3] * d_exper + b[4] * d_tenure)), 2)   # 3.03

# ------------------------------------------------------------------
# Data: wage1 (wage = average hourly earnings in dollars; educ = years of education; exper = years of experience; tenure = years with the current employer). Using the same regression of log(wage) on educ, exper and tenure, what is the predicted hourly wage, in dollars, of a worker with 12 years of education, 10 years of experience and 3 years of tenure? (round to the hundredths)
# Hint: predict log(wage) first, then undo the log with exp(): exp(b[1] + b[2]*12 + b[3]*10 + b[4]*3).
library(wooldridge)
data("wage1")
reg <- lm(log(wage) ~ educ + exper + tenure, data = wage1)
b <- reg$coefficients
educ_val   <- 12    # edit
exper_val  <- 10    # edit
tenure_val <- 3     # edit
round(unname(exp(b[1] + b[2] * educ_val + b[3] * exper_val + b[4] * tenure_val)), 2)   # 4.46

