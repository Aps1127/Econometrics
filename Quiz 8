# Holding everything else fixed, which change makes Var(B1hat) smaller?
#   ANSWER: More spread-out values of X (a larger SST_X).


# Under SLR1-SLR5, the error standard deviation is sigma = 6. A sample has the five X values x = (3,4,7,8,9). Find sd(B1hat). (round to the hundredths)
sigma <- 6                            # INPUT
x <- c(3, 4, 7, 8, 9)                 # INPUT
SSTx <- sum((x - mean(x))^2)
sigma / sqrt(SSTx)                    # check: 1.16
#   if given sigma^2 instead: sqrt(sigma2) / sqrt(SSTx)   |   Var(B1hat) if asked: sigma^2 / SSTx


# A simple regression on n = 24 observations has SSR = 159. Find the estimate of the error variance, sigmahat^2. (round to the hundredths)
n <- 24; SSR <- 159                   # INPUT
SSR / (n - 2)                         # check: 7.23
#   sigmahat (standard error of the regression) if asked: sqrt(SSR / (n - 2))


# A simple regression on n = 11 observations has SSR = 492, and SST_X = 5. Find the standard error se(B1hat). (round to the hundredths)
n <- 11; SSR <- 492; SSTx <- 5        # INPUT
sigmahat <- sqrt(SSR / (n - 2))
sigmahat / sqrt(SSTx)                 # check: 3.31
