# Population covariance Cov(X,Y) = E[XY] - E[X]E[Y]
x <- c(3, 4, 3)
y <- c(3, 8, 8)
p <- c(0.2, 0.3, 0.5)
EX  <- sum(x * p)
EY  <- sum(y * p)
EXY <- sum(x * y * p)
EXY - EX * EY

# Population regression slope b1 = Cov(X,Y) / Var(X)
x <- c(4, 3, 1)
y <- c(4, 7, 8)
p <- c(0.2, 0.3, 0.5)
EX    <- sum(x * p)
EY    <- sum(y * p)
covXY <- sum(x * y * p) - EX * EY
varX  <- sum(x^2 * p) - EX^2
covXY / varX

