# Quiz 9 cheat sheet (Problem Set 10)
# Round every numeric answer to the hundredths place.

# install.packages("wooldridge")   # run once if needed
library(wooldridge)

# ------------------------------------------------------------------
# A regression gives test score-hat = 12 + 8 log(income). What does the 8 mean?
# ANSWER: A 1% rise in income is associated with a rise of about 0.08 points in the predicted test score.

# ------------------------------------------------------------------
# A log-level regression gives log(y)-hat = 2.3 + 0.01 x. By about what percent does y change when x falls by 3? (Give a percent; it can be negative.) (round to the hundredths)
# Hint: log-level: %change y = 100 * beta1 * change in x, and a fall means change in x is negative.
beta1   <- 0.01     # edit
delta_x <- -3       # edit (negative because x falls)
round(100 * beta1 * delta_x, 2)    # -3.00

# ------------------------------------------------------------------
# Data: bwght (bwght = a baby's birth weight in ounces; faminc = the family's income in thousands of dollars). Run the log-log regression lm(log(bwght) ~ log(faminc), data = bwght). By about what percent does predicted birth weight change when family income rises by 20%? (Give a percent.) (round to the hundredths)
# Hint: log-log: %change y = beta1 * %change x. The slope is an elasticity.
data("bwght")
reg_bw <- lm(log(bwght) ~ log(faminc), data = bwght)
pct_x  <- 20        # edit (% change in family income)
round(coef(reg_bw)[2] * pct_x, 2)  # 0.41

