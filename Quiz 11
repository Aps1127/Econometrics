# --------------------------------------------------------------
# For a test of H0: b_j = 0 against H1: b_j > 0 at the 5% level
# with df = 12, find the critical value c.
# --------------------------------------------------------------
alpha <- 0.05   # INPUT
df    <- 12     # INPUT
c_right <- qt(1 - alpha, df)    # H1: b_j > 0  -> right tail, c positive
round(c_right, 2)               # 1.78
# OPPOSITE (H1: b_j < 0, left tail):
round(qt(alpha, df), 2)         # -1.78
# Two-sided (H1: b_j != 0):
round(qt(1 - alpha/2, df), 2)   # 2.18  (reject if |t| > c)


# --------------------------------------------------------------
# For a test of H0: b_j = 0 against H1: b_j < 0 at the 5% level
# with df = 37, find the critical value c.
# --------------------------------------------------------------
alpha <- 0.05   # INPUT
df    <- 37     # INPUT
c_left <- qt(alpha, df)          # H1: b_j < 0  -> left tail, c negative
round(c_left, 2)                 # -1.69
# OPPOSITE (H1: b_j > 0, right tail):
round(qt(1 - alpha, df), 2)      # 1.69


# --------------------------------------------------------------
# You test H0: b_j = 0 against H1: b_j < 0 at the 5% level with df = 30,
# so c = -1.70. Two researchers with different samples get t = -2.10
# and t = -1.20. Which conclusions are correct?
# --------------------------------------------------------------
alpha <- 0.05            # INPUT
df    <- 30              # INPUT
t_vals <- c(-2.10, -1.20) # INPUT
c <- qt(alpha, df); round(c, 2)    # -1.70
ifelse(t_vals < c, "Reject H0", "Fail to reject H0")
# ANSWER: Reject H0 when t = -2.10; fail to reject when t = -1.20.
# OPPOSITE version (H1: b_j > 0, c = +1.70, t = 2.10 and 1.20):
#         Reject when t = 2.10; fail to reject when t = 1.20.
# Traps: "Reject in both cases because both negative" (wrong);
#        "one-sided only rejects when t positive" (wrong)


