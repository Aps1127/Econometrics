# LOG-LEVEL with TWO x's: log(y) = b0 + b1*x1 + b2*x2. x1 changes by dx1 and x2 by dx2. Percent change in y?
b1 <- -0.051; dx1 <- 3                   # INPUT slope WITH its sign, change WITH its sign
b2 <-  0.035; dx2 <- 2                   # INPUT
