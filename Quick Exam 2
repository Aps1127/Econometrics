##########################################################################
##  D. VARIANCE OF OLS / STANDARD ERRORS  (given numbers)
##########################################################################

# Var(b1hat) = sigma^2 / SST_X. Given sigma^2 and SST_X, find Var(b1hat).
sigma2 <- 9; SSTx <- 40                  # INPUT
sigma2 / SSTx

# Given the error SD sigma and the x values, find sd(b1hat).
sigma <- 2; x <- c(2, 5, 7, 9, 12)       # INPUT
sigma / sqrt(sum((x - mean(x))^2))

# Given n and the sample SD (or variance) of x, find SST_X.
n <- 149; Sx <- 3.2                      # INPUT  (given the VARIANCE: Sx <- sqrt(variance))
(n - 1) * Sx^2                           # check: 1515.52

# Given sigma, n, and the sample variance of x, find sd(b1hat).
sigma <- 3; n <- 26; Sx2 <- 4            # INPUT
sigma / sqrt((n - 1) * Sx2)              # check: 0.3

# SIMPLE regression: given n and SSR, find the estimate of the error variance sigma-hat^2.
n <- 30; SSR <- 190                      # INPUT
SSR / (n - 2)                            # (simple regression divides by n - 2)

# SIMPLE regression: given n, SSR, and SST_X (or sd of x), find the standard error se(b1hat).
n <- 30; SSR <- 190; SSTx <- 80          # INPUT  (given sd of x instead: SSTx <- (n - 1) * sd^2)
sqrt(SSR / (n - 2)) / sqrt(SSTx)

# The sample is k times as large (x spread the same way). New sd(b1hat)?
sd_old <- 0.45; k <- 3                   # INPUT
sd_old / sqrt(k)                         # check: 0.26

# MULTIPLE regression with K x's on n observations has SSR. Find the standard error of the regression sigma-hat.
n <- 48; K <- 3; SSR <- 1595             # INPUT  (K = number of x's, not counting the intercept)
sqrt(SSR / (n - K - 1))                  # check: 6.02

# Given sigma-hat, SST_j, and R_j^2, find se(bjhat).
sigma_hat <- 6.2; SSTj <- 360; R2j <- 0.66   # INPUT
sigma_hat / sqrt(SSTj * (1 - R2j))       # check: 0.56


##########################################################################
##  E. STANDARD ERROR BY HAND IN R  (PS12 #8-13)  - one line per piece
##  EDIT the reg line and the variable names. Example: X_j = bdrms.
##########################################################################
library(wooldridge)
reg <- lm(price ~ sqrft + bdrms + lotsize, data = hprice1)      # INPUT the regression from the question

# How many degrees of freedom does the regression have, df = n - K - 1?
df <- nrow(hprice1) - 3 - 1              # INPUT 3 = number of x's (K)
df                                       # check: 84

# Compute the standard error of the regression, sigma-hat = sqrt(SSR / df).
SSR <- sum(reg$residuals^2)
sigma_hat <- sqrt(SSR / df)
sigma_hat                                # check: 59.83   (same as summary(reg)$sigma)

# Compute SST_j for X_j, the total variation of X_j around its mean.
SST_j <- sum((hprice1$bdrms - mean(hprice1$bdrms))^2)           # INPUT the X_j variable
SST_j                                    # check: 61.59

# Compute R_j^2: the R^2 from regressing X_j on the OTHER independent variables.
R2_j <- summary(lm(bdrms ~ sqrft + lotsize, data = hprice1))$r.squared   # INPUT X_j ~ the other x's (NO y)
R2_j                                     # check: 0.28

# Put the pieces together: se(bjhat) = sigma-hat / sqrt(SST_j * (1 - R_j^2)).
sigma_hat / sqrt(SST_j * (1 - R2_j))     # check: 9.01

# The quick way: the standard error from summary(reg)$coefficients.
summary(reg)$coefficients["bdrms", "Std. Error"]                # INPUT the name   check: 9.01

# SIMPLE regression version. Data: ceosal1, reg <- lm(salary ~ roe). Standard error of the roe slope by hand.
library(wooldridge); reg <- lm(salary ~ roe, data = ceosal1)
sqrt(sum(reg$residuals^2) / (nrow(ceosal1) - 2)) / sqrt(sum((ceosal1$roe - mean(ceosal1$roe))^2))   # check: 11.12

# Data: wage1, reg <- lm(wage ~ educ). Standard error of the regression sigma-hat?
library(wooldridge); reg <- lm(wage ~ educ, data = wage1)
sqrt(sum(reg$residuals^2) / (nrow(wage1) - 2))                  # check: 3.38

# Data: wage1. SST_x for educ, the total sum of squares of the explanatory variable?
library(wooldridge)
sum((wage1$educ - mean(wage1$educ))^2)                          # check: 4025.43


