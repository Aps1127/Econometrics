# A regression has explained sum of squares SSE = 93 and R^2 = 0.16. Find the sum of squared residuals SSR. (round to the hundredths)
SSE <- 93                             # INPUT
R2  <- 0.16                           # INPUT
SST <- SSE / R2
SSR <- SST - SSE
SSR                                   # check: 488.25


# A sample of n = 11 observations has sample variance Sy^2 = 6. Find the total sum of squares SST. (round to the hundredths)
n  <- 11                              # INPUT
S2 <- 6                               # INPUT
S2 * (n - 1)                          # check: 60


