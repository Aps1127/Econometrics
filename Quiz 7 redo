#   ANSWER: Line C   (residuals sum to 0 AND smallest sum uhat_i^2)


# E[X] = 5 and E[X^2] = 61. Find the standard deviation of 3X - 7. (round to the hundredths)
EX  <- 5                              # INPUT E[X]
EX2 <- 61                             # INPUT E[X^2]
a   <- 3                              # INPUT number in front of X (the -7 does not matter)
VarX <- EX2 - EX^2
abs(a) * sqrt(VarX)                   # check: 18


# Var(X) = 10, Var(Y) = 12, and Cov(X,Y) = -5.3. Find Var(3X - 3Y). (round to the hundredths)
VarX <- 10; VarY <- 12; CovXY <- -5.3 # INPUT
a <- 3; b <- -3                       # INPUT (keep the minus sign on b)
a^2*VarX + b^2*VarY + 2*a*b*CovXY     # check: 293.4


# X and Y have the joint distribution below. Find Cor(X,Y). (round to the hundredths)
#   x y P(X = x, Y = y)
#   1 5   0.2
#   3 2   0.3
#   4 2   0.4
#   5 9   0.1
X <- c(1, 3, 4, 5)                    # INPUT x column
Y <- c(5, 2, 2, 9)                    # INPUT y column
p <- c(0.2, 0.3, 0.4, 0.1)            # INPUT probability column
EX <- sum(X*p); EY <- sum(Y*p)
CovXY <- sum(X*Y*p) - EX*EY
VarX  <- sum(X^2*p) - EX^2
VarY  <- sum(Y^2*p) - EY^2
CovXY / sqrt(VarX * VarY)             # check: -0.02
#   Cov(X,Y) if asked: CovXY


